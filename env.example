# ==========================================
# FICHIER .env - Variables d'environnement
# ==========================================
# Copiez ce fichier vers .env et remplissez les valeurs
# cp env.example .env

# ==========================================
# DJANGO
# ==========================================
DEBUG=True
SECRET_KEY=django-insecure-change-me-in-production-USE-A-STRONG-KEY
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ==========================================
# BASE DE DONNÉES (PostgreSQL)
# ==========================================
POSTGRES_DB=alsaba_db
POSTGRES_USER=alsaba_user
POSTGRES_PASSWORD=alsaba_password

# Variables pour Django (utilisées dans docker-compose.yml)
DATABASE_NAME=alsaba_db
DATABASE_USER=alsaba_user
DATABASE_PASSWORD=alsaba_password
DATABASE_HOST=db
DATABASE_PORT=5432

# ==========================================
# REDIS & CELERY
# ==========================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ==========================================
# FLUTTERWAVE (Paiements)
# ==========================================
# Environnement: sandbox ou production
FLUTTERWAVE_ENVIRONMENT=sandbox

# Configuration Sandbox (pour développement/test)
FLUTTERWAVE_SANDBOX_CLIENT_ID=votre_client_id_sandbox
FLUTTERWAVE_SANDBOX_CLIENT_SECRET=votre_client_secret_sandbox
FLUTTERWAVE_SANDBOX_ENCRYPTION_KEY=votre_encryption_key_sandbox
FLUTTERWAVE_SANDBOX_BASE_URL=https://developersandbox-api.flutterwave.com
FLUTTERWAVE_SANDBOX_AUTH_URL=https://idp.flutterwave.com/realms/flutterwave/protocol/openid-connect/token

# Configuration Production (pour production)
FLUTTERWAVE_PRODUCTION_CLIENT_ID=votre_client_id_production
FLUTTERWAVE_PRODUCTION_CLIENT_SECRET=votre_client_secret_production
FLUTTERWAVE_PRODUCTION_ENCRYPTION_KEY=votre_encryption_key_production
FLUTTERWAVE_PRODUCTION_BASE_URL=https://api.flutterwave.com
FLUTTERWAVE_PRODUCTION_AUTH_URL=https://idp.flutterwave.com/realms/flutterwave/protocol/openid-connect/token

# Configuration commune Flutterwave
FLUTTERWAVE_REDIRECT_URL=https://google.com
FLUTTERWAVE_WEBHOOK_SECRET=votre_webhook_secret
FLUTTERWAVE_TIMEOUT=30
FLUTTERWAVE_MAX_RETRIES=3
FLUTTERWAVE_RETRY_DELAY=2

# ==========================================
# DIDIT (KYC)
# ==========================================
DIDIT_API_KEY=votre_didit_api_key
DIDIT_WEBHOOK_SECRET=votre_didit_webhook_secret

# ==========================================
# PGADMIN (Optionnel)
# ==========================================
PGADMIN_EMAIL=admin@alsaba.com
PGADMIN_PASSWORD=admin


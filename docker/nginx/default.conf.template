# Reverse-proxy TLS devant Daphne.
# Rendu au demarrage par nginx:alpine (substitution des variables ${...}).

upstream alsaba_app {
    server web:8000;
}

# Requis pour la montee en WebSocket : relaie "upgrade" et ferme sinon.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# HTTP -> HTTPS, sauf les sondes de sante (appelees en interne en clair).
server {
    listen 80;
    server_name ${NGINX_SERVER_NAME};

    location ~ ^/(health|ready)/$ {
        proxy_pass http://alsaba_app;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${NGINX_SERVER_NAME};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;

    # Les justificatifs KYC et les recus peuvent etre volumineux.
    client_max_body_size 20M;

    # Fichiers servis par nginx : Daphne n'a pas a s'en occuper.
    location /static/ {
        alias /app/staticfiles/;
        expires 30d;
        access_log off;
    }

    location /media/ {
        alias /app/media/;
        expires 7d;
    }

    location / {
        proxy_pass http://alsaba_app;

        # X-Forwarded-Proto est LU par Django (SECURE_PROXY_SSL_HEADER).
        # On l'ecrase systematiquement : sans ca, un client pourrait envoyer
        # l'en-tete lui-meme et faire croire a Django que la requete est en HTTPS.
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # Montee en WebSocket (channels / notifications temps reel).
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_read_timeout 300s;
    }
}

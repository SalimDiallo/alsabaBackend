# ===================================
# Variables d'environnement - EXEMPLE
# Copiez ce fichier vers .env et modifiez les valeurs
# ===================================

# Django
DEBUG=False
SECRET_KEY=remplacez_par_une_cle_secrete
ALLOWED_HOSTS=api.votredomaine.com,votredomaine.com

# PostgreSQL
POSTGRES_DB=alsaba_db
POSTGRES_USER=alsaba_user
POSTGRES_PASSWORD=mot_de_passe_fort

# Redis
REDIS_URL=redis://redis:6379/1


# Didit
DIDIT_API_KEY=dp_live_xxx
DIDIT_WEBHOOK_SECRET=webhook_secret_didit

# Flutterwave
FLUTTERWAVE_SECRET_KEY=fw_live_xxx
FLUTTERWAVE_WEBHOOK_SECRET=webhook_secret_flutterwave
FLUTTERWAVE_PUBLIC_KEY=fw_pub_xxx
FLUTTERWAVE_PRODUCTION_CLIENT_ID=fw_client_id
FLUTTERWAVE_PRODUCTION_CLIENT_SECRET=fw_client_secret

# ===================================
# MONITORING
# ===================================
# Sentry : DSN du projet (Settings > Projects > alsaba > Client Keys (DSN)).
# Laisser vide desactive completement Sentry.
SENTRY_DSN=https://xxxxxxxx@oXXXXX.ingest.sentry.io/XXXXXXX
ENVIRONMENT=production
# Envoyer a Sentry meme avec DEBUG=True (verification locale uniquement)
SENTRY_FORCED=False
# Version de l'app : sert au suivi des regressions par release
SENTRY_RELEASE=alsaba@1.0.0

# Flower (monitoring Celery) : auth basique OBLIGATOIRE, format user:password
FLOWER_BASIC_AUTH=admin:changeme

# Webhook d'alerte du service de backup (Slack / Discord). Vide = pas d'alerte
# si un backup PostgreSQL echoue.
ALERT_WEBHOOK_URL=

# CORS
CORS_ALLOWED_ORIGINS=https://votredomaine.com,https://app.votredomaine.com

# ===================================
# Email SMTP (OBLIGATOIRE en production)
# NotificationService envoie des emails (dépôts, offres...). Sans EMAIL_HOST,
# le démarrage échoue en prod (DEBUG=False). En dev, laissez vide -> console.
# ===================================
EMAIL_HOST=smtp.votrefournisseur.com
EMAIL_PORT=587
EMAIL_HOST_USER=postmaster@votredomaine.com
EMAIL_HOST_PASSWORD=mot_de_passe_smtp
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@votredomaine.com

# ===================================
# JWT (durée des tokens) - valeurs par défaut : 60 min / 7 jours
# ===================================
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Sécurité prod (optionnel : SECURE_SSL_REDIRECT=True par défaut si DEBUG=False)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Intervalles Celery (secondes)
OFFER_CHECK_INTERVAL=600
TRANSACTION_RECONCILE_INTERVAL=1800

# ExchangeRate-API : sans cette cle, l'app retombe en SILENCE sur des taux
# de change codes en dur. https://www.exchangerate-api.com
EXCHANGERATE_API_KEY=

# Firebase FCM : chemin DANS le conteneur du service account JSON.
# Le fichier vit dans Project/ et est monte en lecture seule.
GOOGLE_APPLICATION_CREDENTIALS=/app/firebase-credentials.json
FLUTTERWAVE_ENCRYPTION_KEY=fw_enc_xxx
# 'sandbox' ou 'production'. Rester en sandbox = aucun paiement reel.
FLUTTERWAVE_ENVIRONMENT=production

# ngrok : tests de webhooks en developpement uniquement.
NGROK_AUTH_TOKEN=

# ===================================
# PRODUCTION
# ===================================
# Domaine servi par nginx (obligatoire pour la stack de prod)
NGINX_SERVER_NAME=
# Cle de chiffrement des documents KYC. Decouplee de SECRET_KEY : sans elle,
# toute rotation de SECRET_KEY rend les documents deja stockes ILLISIBLES.
# Vide = repli sur SECRET_KEY (comportement historique).
KYC_ENCRYPTION_KEY=

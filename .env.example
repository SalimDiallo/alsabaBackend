# ===================================
# Variables d'environnement - EXEMPLE
# Copiez ce fichier vers .env et modifiez les valeurs
# ===================================

# Django
DEBUG=False
SECRET_KEY=remplacez_par_une_cle_secrete
ALLOWED_HOSTS=api.votredomaine.com,votredomaine.com

# PostgreSQL
POSTGRES_DB=alsaba_db
POSTGRES_USER=alsaba_user
POSTGRES_PASSWORD=mot_de_passe_fort

# Redis
REDIS_URL=redis://redis:6379/1

# SMS Notifications (Twilio)
TWILIO_ACCOUNT_SID=your_sid
TWILIO_AUTH_TOKEN=your_token
TWILIO_PHONE_NUMBER=your_twilio_number

# Didit
DIDIT_API_KEY=dp_live_xxx
DIDIT_WEBHOOK_SECRET=webhook_secret_didit

# Flutterwave
FLUTTERWAVE_SECRET_KEY=fw_live_xxx
FLUTTERWAVE_WEBHOOK_SECRET=webhook_secret_flutterwave
FLUTTERWAVE_PUBLIC_KEY=fw_pub_xxx
FLUTTERWAVE_PRODUCTION_CLIENT_ID=fw_client_id
FLUTTERWAVE_PRODUCTION_CLIENT_SECRET=fw_client_secret

# Sentry (optionnel)
SENTRY_DSN=
ENVIRONMENT=production

# CORS
CORS_ALLOWED_ORIGINS=https://votredomaine.com,https://app.votredomaine.com

# ===================================
# Email SMTP (OBLIGATOIRE en production)
# NotificationService envoie des emails (dépôts, offres...). Sans EMAIL_HOST,
# le démarrage échoue en prod (DEBUG=False). En dev, laissez vide -> console.
# ===================================
EMAIL_HOST=smtp.votrefournisseur.com
EMAIL_PORT=587
EMAIL_HOST_USER=postmaster@votredomaine.com
EMAIL_HOST_PASSWORD=mot_de_passe_smtp
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@votredomaine.com

# ===================================
# JWT (durée des tokens) - valeurs par défaut : 60 min / 7 jours
# ===================================
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Sécurité prod (optionnel : SECURE_SSL_REDIRECT=True par défaut si DEBUG=False)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Intervalles Celery (secondes)
OFFER_CHECK_INTERVAL=600
TRANSACTION_RECONCILE_INTERVAL=1800